rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasUserDoc(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserRole(userId) {
      return hasUserDoc(userId) ? getUserData(userId).role : 'none';
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole(request.auth.uid) == role;
    }

    function isCampaigner() {
      return isRole('campaigner');
    }

    function isCreator() {
      return isRole('creator');
    }

    function isReviewer() {
      return isRole('reviewer');
    }

    match /users/{userId} {
      // Authenticated users can read their own profile; reviewers can read user profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isReviewer());

      // Written at signup/first login for own document
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['campaigner', 'creator', 'reviewer']
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);

      // 1. Self-update of non-role fields (displayName etc.) by the user themselves,
      // explicitly forbidding the role field from changing:
      allow update: if isAuthenticated() 
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      // 2. Role-field update on ANY user's document, permitted only when the requester's own role
      // (looked up via getUserRole(request.auth.uid)) is 'reviewer', restricted to only the role
      // and updatedAt fields via affectedKeys():
      allow update: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'reviewer'
        && request.resource.data.role in ['campaigner', 'creator', 'reviewer']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

      // Client cannot delete their user profile
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      // Read: Reviewers, campaign owners, or assigned creators
      allow read: if isAuthenticated() && (
        isReviewer() ||
        resource.data.ownerId == request.auth.uid ||
        (isCreator() && ('assignedCreators' in resource.data) && (request.auth.uid in resource.data.assignedCreators))
      );

      // Create: ONLY the owning campaigner
      allow create: if isAuthenticated() 
        && isCampaigner()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Update: ONLY the owning campaigner
      allow update: if isAuthenticated()
        && isCampaigner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Delete: ONLY the owning campaigner
      allow delete: if isAuthenticated()
        && isCampaigner()
        && resource.data.ownerId == request.auth.uid;

      // Audit trail subcollection
      match /audit_trail/{versionId} {
        // Read: Reviewers and the owning campaigner
        allow read: if isAuthenticated() && (
          isReviewer() ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid
        );

        // Create: Creator matching report creatorId or owning campaigner / reviewer
        allow create: if isAuthenticated() && (
          isReviewer() ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid ||
          (isCreator() && request.resource.data.creatorId == request.auth.uid)
        );

        // Update/Delete: Fully denied (immutable audit log)
        allow update: if false;
        allow delete: if false;
      }
    }

    match /compliance_reports/{reportId} {
      // Read: Reviewers, report creator, or owning campaigner
      allow read: if isAuthenticated() && (
        isReviewer() ||
        (isCreator() && resource.data.creatorId == request.auth.uid) ||
        (isCampaigner() && ('campaignId' in resource.data) && get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.ownerId == request.auth.uid)
      );

      // Create: Creators can create a report ONLY for themselves
      allow create: if isAuthenticated()
        && isCreator()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.submittedContentText is string
        && request.resource.data.submittedContentText.size() > 0;

      // Update: Reviewers ONLY can update reviewerDecision (and updatedAt timestamp)
      // Immutable fields: aiReasoning, deterministicFindings, submittedContentText, creatorId
      allow update: if isAuthenticated()
        && isReviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewerDecision', 'updatedAt'])
        && request.resource.data.submittedContentText == resource.data.submittedContentText
        && request.resource.data.creatorId == resource.data.creatorId;

      // Delete: Denied to preserve compliance records
      allow delete: if false;
    }

    match /regulatory_entries/{entryId} {
      // Read: All authenticated users
      allow read: if isAuthenticated();

      // Create/Update/Delete: Reviewers ONLY
      allow create: if isAuthenticated()
        && isReviewer()
        && request.resource.data.source is string
        && request.resource.data.documentName is string;

      allow update: if isAuthenticated()
        && isReviewer()
        && request.resource.data.source is string
        && request.resource.data.documentName is string;

      allow delete: if isAuthenticated() && isReviewer();
    }

    match /test/{testId} {
      allow read: if isAuthenticated();
    }
  }
}
