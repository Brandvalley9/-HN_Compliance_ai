rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasUserDoc(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserRole(userId) {
      return hasUserDoc(userId) ? getUserData(userId).role : 'none';
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole(request.auth.uid) == role;
    }

    function isCampaigner() {
      return isRole('campaigner');
    }

    function isCreator() {
      return isRole('creator');
    }

    function isReviewer() {
      return isRole('reviewer');
    }

    match /users/{userId} {
      // Authenticated users can read their own profile; reviewers can read user profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isReviewer());

      // Written at signup/first login for the user's OWN document. Self-registration can only ever
      // produce a campaigner or a creator. 'reviewer' is privileged so it can only be granted
      // by an administrator or via the role-update rule below.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['campaigner', 'creator']
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);

      // Self-update of non-role fields by the user themselves
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      // Role updates can only be executed by an existing reviewer
      allow update: if isAuthenticated()
        && isReviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      // Read: Reviewers, campaign owners, or assigned creators
      allow read: if isAuthenticated() && (
        isReviewer() ||
        resource.data.ownerId == request.auth.uid ||
        (isCreator() && ('assignedCreators' in resource.data) && (request.auth.uid in resource.data.assignedCreators))
      );

      // Create: ONLY the owning campaigner
      allow create: if isAuthenticated() 
        && isCampaigner()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Update: ONLY the owning campaigner
      allow update: if isAuthenticated()
        && isCampaigner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Delete: ONLY the owning campaigner
      allow delete: if isAuthenticated()
        && isCampaigner()
        && resource.data.ownerId == request.auth.uid;

      // Audit trail subcollection
      match /audit_trail/{versionId} {
        allow read: if isAuthenticated() && (
          isReviewer() ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          isReviewer() ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid ||
          (isCreator() && request.resource.data.creatorId == request.auth.uid)
        );

        allow update: if false;
        allow delete: if false;
      }
    }

    match /compliance_reports/{reportId} {
      // Read: Reviewers, the report's creator, or the campaign owner
      allow read: if isAuthenticated() && (
        isReviewer() ||
        resource.data.creatorId == request.auth.uid ||
        (isCampaigner() && ('campaignId' in resource.data) && get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.ownerId == request.auth.uid)
      );

      // Create: DENIED to every client. Reports are authored by the server (Admin SDK).
      allow create: if false;

      // Update: Reviewers ONLY can update reviewerDecision
      allow update: if isAuthenticated()
        && isReviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewerDecision', 'updatedAt']);

      allow delete: if false;
    }

    match /regulatory_entries/{entryId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isReviewer()
        && request.resource.data.source is string
        && request.resource.data.documentName is string;

      allow update: if isAuthenticated()
        && isReviewer()
        && request.resource.data.source is string
        && request.resource.data.documentName is string;

      allow delete: if isAuthenticated() && isReviewer();
    }

    match /test/{testId} {
      allow read: if isAuthenticated();
    }
  }
}
